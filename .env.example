DATABASE_URL=postgres://user:password@host:5432/dbname
# The public origin. Used by better-auth and for invitation links.
BETTER_AUTH_URL=https://autotriz.com.bd
# Other origins allowed to reach the auth endpoints — a staging
# domain, a preview URL. Comma-separated, no trailing slashes.
BETTER_AUTH_TRUSTED_ORIGINS=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Extra image hosts next/image may serve from, comma-separated. Only
# needed when the media library still holds rows pointing at a CDN the
# shop has moved away from.
IMAGE_HOSTS=

R2_PUBLIC_URL=
# Outgoing email for staff invites. Without these, an invite still works —
# the admin is given a link to pass on by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
